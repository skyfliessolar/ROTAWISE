rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- who is signed in ----
    function signedIn() { return request.auth != null; }
    function isOwner() { return signedIn() && request.auth.uid == '5nI7ZEVbX8Uya6Kc2HGeEpu5tFx1'; }
    function staffPath() { return /databases/$(database)/documents/gas_staff/$(request.auth.uid); }
    function isStaff() { return isOwner() || (signedIn() && exists(staffPath()) && get(staffPath()).data.active == true); }
    function role() { return get(staffPath()).data.role; }
    function isAdmin() { return isOwner() || (isStaff() && role() == 'admin'); }
    function isManager() { return isAdmin() || (isStaff() && role() == 'manager'); }

    // ---- stores: staff with stores ticked only see those stores; managers see all ----
    function myStores() { return get(staffPath()).data.get('stores', []); }
    function storeOk(d) { return isManager() || myStores().size() == 0 || d.storeId in myStores(); }

    // ---- helpers ----
    function same(f) { return request.resource.data.get(f, null) == resource.data.get(f, null); }
    // staff may fix their own new entries for 30 minutes
    function ownFresh() {
      return resource.data.get('createdByUid', '') == request.auth.uid
        && request.time.toMillis() - resource.data.get('createdAt', 0) < 1800000;
    }

    // Orders and sales: everyone can add; once saved, only managers change payment/amount/cylinders/customer/store
    match /gas_orders/{id} {
      allow read: if isStaff() && storeOk(resource.data);
      allow create: if isManager() || (isStaff()
        && storeOk(request.resource.data)
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt is int
        && request.resource.data.createdAt > request.time.toMillis() - 600000
        && request.resource.data.createdAt < request.time.toMillis() + 600000
        && request.resource.data.get('deleted', false) == false);
      allow update: if isManager() || (isStaff()
        && storeOk(resource.data) && storeOk(request.resource.data)
        && same('createdAt') && same('createdByUid') && same('deleted')
        && (ownFresh() || (same('payStatus') && same('amount') && same('items') && same('customer')
                          && same('date') && same('orderNo') && same('method') && same('storeId'))));
      allow delete: if isAdmin();
    }
    match /gas_stock/{id} {
      allow read: if isStaff() && storeOk(resource.data);
      allow create, update, delete: if isManager();
    }
    match /gas_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Employee list: only the admin sees it; each person can read their own record
    match /gas_staff/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
    }
    // Names, codes and stores (no emails) so managers can send reminders to employees
    match /gas_team/{uid} {
      allow read: if isManager();
      allow write: if isAdmin();
    }
    // Login code -> version lookup used on the sign-in screen (no personal data)
    match /gas_logins/{code} {
      allow get: if true;
      allow list: if false;
      allow write: if isAdmin();
    }
    // Change history: anyone writes their own entries, only managers read, nobody edits
    match /gas_audit/{id} {
      allow read: if isManager();
      allow create: if isStaff() && request.resource.data.byUid == request.auth.uid;
      allow update, delete: if false;
    }
    match /gas_presence/{uid} {
      allow read: if isManager();
      allow write: if isStaff() && request.auth.uid == uid;
    }
    // Reminders: managers manage all. An employee sees reminders sent to them,
    // sets their own (only for themselves), and can mark any of theirs done.
    match /gas_reminders/{id} {
      allow read: if isManager() || (isStaff() && request.auth.uid in resource.data.toUids);
      allow create: if isManager() || (isStaff()
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.toUids == [request.auth.uid]);
      allow update: if isManager() || (isStaff() && request.auth.uid in resource.data.toUids && (
        (resource.data.get('createdByUid', '') == request.auth.uid
          && request.resource.data.createdByUid == request.auth.uid
          && request.resource.data.toUids == [request.auth.uid])
        || request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['active', 'doneAt', 'nextAt', 'sentFor', 'doneBy', 'doneByUid'])));
      allow delete: if isManager() || (isStaff() && resource.data.get('createdByUid', '') == request.auth.uid);
    }
    match /gas_admin/{id} {
      allow read, write: if isAdmin();
    }
    // ---- Rotawise hub: free shops anyone can create ----
    // Each shop has its own login shop-<id>@shops.rotawise.app. Its password sits in hub_keys/<id>:
    // readable by anyone while the shop is open, otherwise only by the shop itself and the admin.
    function shopUser(s) { return s != 'main' && signedIn() && request.auth.token.email == ('shop-' + s + '@shops.rotawise.app'); }
    function validShop() {
      let d = request.resource.data;
      return d.keys().hasOnly(['name', 'nameLower', 'access', 'createdAt', 'updatedAt', 'hidden'])
        && d.name is string && d.name.size() >= 2 && d.name.size() <= 60
        && d.nameLower == d.name.lower() && d.access in ['open', 'password'];
    }
    match /hub_shops/{s} {
      allow read: if true;
      allow create: if shopUser(s) && validShop();
      allow update: if (shopUser(s) || isAdmin()) && validShop();
      allow delete: if isAdmin();
      // a shop's own data (Gas, Goods Orders, Rota, Cash...). 'main' is the business itself.
      match /{rest=**} {
        allow read, write: if shopUser(s) || isAdmin() || (s == 'main' && isStaff());
      }
    }
    match /hub_keys/{s} {
      allow get: if shopUser(s) || isAdmin() || get(/databases/$(database)/documents/hub_shops/$(s)).data.access == 'open';
      allow list: if isAdmin();
      allow create, update: if (shopUser(s) || isAdmin())
        && request.resource.data.keys().hasOnly(['pw', 'updatedAt'])
        && request.resource.data.pw is string && request.resource.data.pw.size() >= 4;
      allow delete: if isAdmin();
    }
    match /hub_settings/{id} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }
    // Copy of the Rotawise (Supabase) data: admin only
    match /{coll}/{doc} {
      allow read, write: if coll.matches('rw_[a-z_]+') && isAdmin();
    }
  }
}
